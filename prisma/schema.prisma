
generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  services Service[]
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imagePath    String 
  price       Float
  currency    String
  minUnits    Int      @default(1)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
}
