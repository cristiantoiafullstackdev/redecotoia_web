generator client {
  provider        = "prisma-client-js"
  // previewFeatures = ["driverAdapters"]
  output          = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  services Service[]
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
}
